# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./qurly.db

# For production (Supabase PostgreSQL)
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/database

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://your-backend.onrender.com

# Environment
ENVIRONMENT=production

# Optional: Google OAuth (not yet implemented)
# GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
