# ================================================================
# QURLY - Environment Variables Configuration Template
# ================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env with real secrets to version control
# ================================================================

# FastAPI
ENVIRONMENT=development
DEBUG=true
API_TITLE=Qurly API
API_VERSION=2.0.0
API_DESCRIPTION=AI Representation Optimizer for Shopify Products

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
# SQLite (Local Development) - default
DATABASE_URL=sqlite:///./qurly.db

# PostgreSQL (Supabase - Production)
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# ================================================================
# AUTHENTICATION & JWT
# ================================================================
# Generate JWT secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Legacy support for ACCESS_TOKEN_EXPIRE_MINUTES (7 days = 10080 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ================================================================
# AI/LLM CONFIGURATION
# ================================================================
# Google Gemini API Key (get from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-1.5-flash

# ================================================================
# FRONTEND & CORS CONFIGURATION
# ================================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000
CORS_ENABLED=true
CORS_CREDENTIALS=true

# ================================================================
# SECURITY
# ================================================================
SECRET_KEY=your-secret-key-here-change-in-production

# ================================================================
# LOGGING
# ================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ================================================================
# API RATE LIMITING
# ================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ================================================================
# WEB SCRAPING
# ================================================================
SCRAPER_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ================================================================
# CACHING
# ================================================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ================================================================
# FEATURE FLAGS
# ================================================================
ENABLE_PDF_EXPORT=true
ENABLE_ANALYTICS=true
ENABLE_ADVANCED_NLP=true

# ================================================================
# OAUTH (Optional for future enhancement)
# ================================================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ================================================================
# EMAIL CONFIGURATION (Optional - for contact form/notifications)
# ================================================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# CONTACT_EMAIL=support@qurly.com

# ================================================================
# MONITORING & ERRORS (Optional)
# ================================================================
# SENTRY_DSN=https://...@sentry.io/...


# Monitoring
SENTRY_DSN=

# Features
ENABLE_ANALYTICS=true
ENABLE_REWRITE_FEATURE=true
ENABLE_USER_ACCOUNTS=true
ENABLE_HISTORICAL_TRACKING=true
ENABLE_ADVANCED_NLP=true
ENABLE_PDF_EXPORT=true
ENABLE_MULTI_PRODUCT_COMPARISON=true
