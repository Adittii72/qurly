# Database Configuration
# For Supabase PostgreSQL (Production)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database_name
# For local SQLite (Development)
# DATABASE_URL=sqlite:///./qurly.db

# AI/ML Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=30

# Security & Authentication
SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & URLs
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://your-backend.onrender.com
CORS_ENABLED=true

# Environment
ENVIRONMENT=production
DEBUG=false

# Scraping Configuration
SCRAPER_TIMEOUT=10
SCRAPER_MAX_RETRIES=3

# Features
ENABLE_ANALYTICS=true
ENABLE_REWRITE_FEATURE=true
ENABLE_USER_ACCOUNTS=true
ENABLE_HISTORICAL_TRACKING=true
ENABLE_ADVANCED_NLP=true
ENABLE_PDF_EXPORT=true
ENABLE_MULTI_PRODUCT_COMPARISON=true
ENABLE_AI_READINESS_CHECKLIST=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
