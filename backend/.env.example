# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./qurly.db

# For production (Supabase PostgreSQL)
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/database

# AI Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_ACTUAL_GEMINI_API_KEY

# JWT Authentication
# Generate a secure random string (minimum 32 characters)
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://your-backend.onrender.com

# Environment
ENVIRONMENT=production

# Optional: Google OAuth (not yet implemented)
# GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
