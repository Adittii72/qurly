# Qurly Backend Configuration

# FastAPI
ENVIRONMENT=development
DEBUG=true
API_TITLE=Qurly API
API_VERSION=1.0.0
API_DESCRIPTION=AI Representation Optimizer for Shopify Products

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# API Limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Scraping
SCRAPER_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# AI/ML
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-pro

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Database (optional - for production)
DATABASE_URL=sqlite:///./qurly.db
# DATABASE_URL=postgresql://user:password@localhost/qurly

# Authentication & OAuth
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Monitoring
SENTRY_DSN=

# Features
ENABLE_ANALYTICS=true
ENABLE_REWRITE_FEATURE=true
ENABLE_USER_ACCOUNTS=true
ENABLE_HISTORICAL_TRACKING=true
ENABLE_ADVANCED_NLP=true
ENABLE_PDF_EXPORT=true
ENABLE_MULTI_PRODUCT_COMPARISON=true
